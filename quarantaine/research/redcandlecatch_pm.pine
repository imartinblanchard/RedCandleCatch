//@version=5
// ══════════════════════════════════════════════════════════════════════════
//  RedCandleCatch — VERSION PM (vérification visuelle des gappers PRÉ-MARCHÉ)
//
//  ⚠️ Le bot NE TRADE PAS les PM (edge trop faible). Cet indicateur sert
//  UNIQUEMENT à ÉTUDIER visuellement les setups PM : il marque le dip d'entrée
//  et la sortie théorique pour les gappers devenus éligibles AVANT l'ouverture.
//
//  Ne marque QUE les gappers PM : gap 10-20% atteint AVANT 09:31 (pré-marché).
//  Dip -5% (valeur PM), activation +5% (valeur PM), stop -10%, trail 2%.
//
//  Graphique 1 MINUTE, heures étendues (ETH) activées.
// ══════════════════════════════════════════════════════════════════════════
indicator("RedCandleCatch_PM", overlay=true, max_labels_count=500, max_lines_count=500)

// ─────────────────────────── Paramètres ───────────────────────────
dipPM     = input.float(5.0,   "Dip PM (%)",                minval=0.1, step=0.5, group="Entrée")
gapMin    = input.float(10.0,  "Gap minimum (%)",           minval=0.0, step=1.0, group="Entrée")
gapMax    = input.float(20.0,  "Gap maximum (%)",           minval=0.0, step=1.0, group="Entrée")
useGap    = input.bool(true,   "Activer le filtre de gap",               group="Entrée")
minPrice  = input.float(3.0,   "Prix minimum ($)",          minval=0.0, group="Entrée")
maxPrice  = input.float(20.0,  "Prix maximum ($)",          minval=0.0, group="Entrée")
gapWin    = input.session("0400-1200", "Fenêtre de mesure du GAP (ET)",  group="Entrée")
entryWin  = input.session("0930-1600", "Fenêtre d'ENTRÉE (ET)",         group="Entrée")

stopPct   = input.float(10.0,  "PHASE 1 — Stop fixe (%)",   minval=0.1, step=0.5, group="Sortie")
actPct    = input.float(5.0,   "Activation du trailing (%)", minval=0.1, step=0.5, group="Sortie")
trailPct  = input.float(2.0,   "PHASE 2 — Trailing (%)",    minval=0.1, step=0.5, group="Sortie")
sessWin   = input.session("0930-1630", "Séance (sortie forcée)",        group="Sortie")

showLines = input.bool(true,   "Afficher stop / trailing",               group="Affichage")
showGapLbl= input.bool(true,   "Afficher le gap du jour",                group="Affichage")
tz = "America/New_York"

// ──────────── Gap = plus-haut 04:00->MIDI vs clôture veille ────────────
prevClose = request.security(syminfo.tickerid, "D", close[1], lookahead=barmerge.lookahead_on)
newDay    = ta.change(time("D")) != 0
inGapWin  = not na(time(timeframe.period, gapWin, tz))
inEntry   = not na(time(timeframe.period, entryWin, tz))
inSess    = not na(time(timeframe.period, sessWin,  tz))

var float mornHigh  = na
var bool  everGapOK = false        // STICKY : une fois éligible, reste éligible
var bool  isPM      = false        // gap 10-20 atteint AVANT 09:31 ?
if newDay
    mornHigh  := na
    everGapOK := false
    isPM      := false
if inGapWin
    mornHigh := na(mornHigh) ? high : math.max(mornHigh, high)

gapPct    = (na(prevClose) or prevClose <= 0 or na(mornHigh)) ? na : (mornHigh / prevClose - 1) * 100
gapInBand = not na(gapPct) and gapPct >= gapMin and gapPct < gapMax
if inGapWin and gapInBand and not everGapOK
    everGapOK := true
    isPM      := (hour(time, tz) < 9) or (hour(time, tz) == 9 and minute(time, tz) < 31)
gapOK = not useGap or everGapOK

// on NE marque QUE les gappers PM
tradablePM = gapOK and isPM

// ─────────────────────── État de la position ───────────────────────
var bool  inPos     = false
var bool  traded    = false        // 1 marque par jour
var bool  activated = false
var float entryP    = na
var float peak      = na
var float stopLvl   = na
var float trailLvl  = na
if newDay
    traded    := false
    inPos     := false
    activated := false
    entryP    := na
    peak      := na
    stopLvl   := na
    trailLvl  := na

isDip = open > 0 and (close - open) / open * 100 <= -dipPM

// ─────────────────────── ENTRÉE (marque visuelle) ───────────────────────
enter = not inPos and not traded and inEntry and tradablePM and isDip and close >= minPrice and close <= maxPrice
if enter
    inPos     := true
    traded    := true
    activated := false
    entryP    := close
    peak      := close
    stopLvl   := close * (1 - stopPct / 100)
    trailLvl  := na
    label.new(bar_index, low,
              "ACHAT PM (dip -" + str.tostring(dipPM, "#.#") + "%)\n" + str.tostring(close, format.mintick),
              color=color.new(color.purple, 15), textcolor=color.white,
              style=label.style_label_up, size=size.small)

// ─────────────── GESTION : phase 1 -> phase 2 -> sortie ───────────────
exitPrice = float(na)
exitTxt   = ""
if inPos and not enter
    peak := math.max(peak, high)
    if not activated and peak >= entryP * (1 + actPct / 100)
        activated := true
        trailLvl  := peak * (1 - trailPct / 100)
    if activated
        trailLvl := math.max(nz(trailLvl, peak * (1 - trailPct / 100)), peak * (1 - trailPct / 100))
    if activated and low <= trailLvl
        exitPrice := trailLvl
        exitTxt   := "TRAIL"
    else if not activated and low <= stopLvl
        exitPrice := stopLvl
        exitTxt   := "STOP"
    else if not inSess
        exitPrice := close
        exitTxt   := "EOD"

if inPos and not na(exitPrice)
    pnl = (exitPrice - entryP) / entryP * 100
    label.new(bar_index, high,
              exitTxt + "\n" + str.tostring(exitPrice, format.mintick) + "\n" + (pnl >= 0 ? "+" : "") + str.tostring(pnl, "#.##") + "%",
              color=color.new(pnl >= 0 ? color.teal : color.red, 15), textcolor=color.white,
              style=label.style_label_down, size=size.small)
    inPos     := false
    activated := false
    entryP    := na
    peak      := na
    stopLvl   := na
    trailLvl  := na

// ─────────────────────── Affichage ───────────────────────
plot(showLines and inPos and not activated ? stopLvl  : na, "Stop -10%",  color=color.red,    linewidth=2, style=plot.style_linebr)
plot(showLines and inPos and activated     ? trailLvl : na, "Trail 2%",   color=color.orange, linewidth=2, style=plot.style_linebr)
plot(showLines and inPos                   ? entryP   : na, "Entrée",     color=color.new(color.gray, 40), linewidth=1, style=plot.style_linebr)
plot(showLines and inPos and not activated ? entryP * (1 + actPct/100) : na, "Seuil activation",
     color=color.new(color.blue, 50), linewidth=1, style=plot.style_linebr)

// pastille au début de séance : gap + PM/post-open
firstRth = inSess and not inSess[1]
if showGapLbl and firstRth and not na(gapPct)
    txt = "gap " + str.tostring(gapPct, "#.#") + "%" + (isPM ? " · PM ✓" : (everGapOK ? " · post-open (ignore)" : " ✗"))
    label.new(bar_index, high, txt,
              color=color.new(isPM ? color.purple : color.gray, 30), textcolor=color.white,
              style=label.style_label_down, size=size.tiny)

bgcolor(inPos ? color.new(activated ? color.orange : color.purple, 92) : na)
