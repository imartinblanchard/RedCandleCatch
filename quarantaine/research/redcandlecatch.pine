//@version=5
// ══════════════════════════════════════════════════════════════════════════
//  RedCandleCatch — Gap POST-OUVERTURE + Dip ADAPTATIF + sortie deux phases
//  (ex-Warrior v3)
//
//  Le gap se mesure sur le plus-haut de 04:00 → MIDI (pas seulement le pré-marché)
//  et l'éligibilité est STICKY (une fois dans la bande 10-20%, on y reste : un pic
//  > 20% ne disqualifie plus -> capte les runners post-open, ex DFDV). Le seuil de
//  dip s'adapte au MOMENT d'éligibilité (comme le bot, PAS le volume) : -5% si
//  éligible avant 09:31 (gapper PM), -1,5% si éligible après (runner post-open).
//  Aligné sur bot/warrior_terminator.py (18/09). Validé OOS (research/).
//
//  À utiliser sur un graphique 1 MINUTE, heures étendues activées.
// ══════════════════════════════════════════════════════════════════════════
indicator("RedCandleCatch_SmallCap", overlay=true, max_labels_count=500, max_lines_count=500)

// ─────────────────────────── Paramètres ───────────────────────────
dipPM     = input.float(5.0,    "Dip PM / micro-cap (%)",   minval=0.1, step=0.5, group="Entrée")
dipPost   = input.float(1.5,    "Dip post-open (%)",        minval=0.1, step=0.5, group="Entrée")
gapMin    = input.float(10.0,   "Gap minimum (%)",          minval=0.0, step=1.0, group="Entrée")
gapMax    = input.float(20.0,   "Gap maximum (%)",          minval=0.0, step=1.0, group="Entrée")
useGap    = input.bool(true,    "Activer le filtre de gap",              group="Entrée")
minPrice  = input.float(3.0,    "Prix minimum ($)",         minval=0.0, group="Entrée")
maxPrice  = input.float(20.0,   "Prix maximum ($)",         minval=0.0, group="Entrée")
gapWin    = input.session("0400-1200", "Fenêtre de mesure du GAP (ET)",  group="Entrée")  // <- post-open
entryWin  = input.session("0930-1600", "Fenêtre d'ENTRÉE (ET)",         group="Entrée")

stopPct   = input.float(10.0,   "PHASE 1 — Stop fixe (%)",  minval=0.1, step=0.5, group="Sortie")
actPct    = input.float(5.0,    "Activation du trailing (%)", minval=0.1, step=0.5, group="Sortie")
trailPct  = input.float(2.0,    "PHASE 2 — Trailing (%)",   minval=0.1, step=0.5, group="Sortie")
sessWin   = input.session("0930-1630", "Séance (sortie forcée)",        group="Sortie")

showLines = input.bool(true,    "Afficher stop / trailing",              group="Affichage")
showGapLbl= input.bool(true,    "Afficher le gap du jour",               group="Affichage")
tz = "America/New_York"

// ──────────── Gap = plus-haut 04:00->MIDI vs clôture veille (POST-OPEN) ────────────
prevClose = request.security(syminfo.tickerid, "D", close[1], lookahead=barmerge.lookahead_on)
newDay    = ta.change(time("D")) != 0
inGapWin  = not na(time(timeframe.period, gapWin, tz))          // 04:00-12:00
inEntry   = not na(time(timeframe.period, entryWin, tz))
inSess    = not na(time(timeframe.period, sessWin,  tz))

var float mornHigh  = na
var bool  everGapOK = false        // STICKY : une fois éligible, le reste de la journée
var bool  isPM      = true         // éligible AVANT 09:31 = gapper PM ; sinon runner post-open
if newDay
    mornHigh  := na
    everGapOK := false
    isPM      := true
if inGapWin
    mornHigh := na(mornHigh) ? high : math.max(mornHigh, high)

gapPct    = (na(prevClose) or prevClose <= 0 or na(mornHigh)) ? na : (mornHigh / prevClose - 1) * 100
gapInBand = not na(gapPct) and gapPct >= gapMin and gapPct < gapMax
// LATCH d'éligibilité (comme le fichier de signaux STICKY du bot) : dès que le gap ENTRE dans
// [gapMin, gapMax) pendant 04:00→midi, on reste éligible toute la journée. Un pic ultérieur
// > 20% ne disqualifie PLUS -> corrige les runners post-open ignorés par la v3 (ex DFDV).
if inGapWin and gapInBand and not everGapOK
    everGapOK := true
    isPM      := (hour(time, tz) < 9) or (hour(time, tz) == 9 and minute(time, tz) < 31)
gapOK = not useGap or everGapOK

// ──────────── Dip ADAPTATIF par MOMENT D'ÉLIGIBILITÉ (comme le bot, PAS par volume) ────────────
// éligible avant l'ouverture -> gapper PM -> dip profond ; éligible après 09:30 -> runner
// post-open -> dip léger. (Remplace l'ancien proxy volume, abandonné.)
effDip = isPM ? dipPM : dipPost

// ─────────────────────── État de la position ───────────────────────
var bool  inPos     = false
var bool  traded    = false        // 1 entrée par ticker par jour
var bool  activated = false
var float entryP    = na
var float peak      = na
var float stopLvl   = na
var float trailLvl  = na

if newDay
    traded    := false
    inPos     := false
    activated := false
    entryP    := na
    peak      := na
    stopLvl   := na
    trailLvl  := na

isDip = open > 0 and (close - open) / open * 100 <= -effDip

// ─────────────────────── ENTRÉE ───────────────────────
enter = not inPos and not traded and inEntry and gapOK and isDip and close >= minPrice and close <= maxPrice
if enter
    inPos     := true
    traded    := true
    activated := false
    entryP    := close
    peak      := close
    stopLvl   := close * (1 - stopPct / 100)
    trailLvl  := na
    label.new(bar_index, low,
              "ACHAT (dip -" + str.tostring(effDip, "#.#") + "%)\n" +
              str.tostring(close, format.mintick),
              color=color.new(color.green, 15), textcolor=color.white,
              style=label.style_label_up, size=size.small)

// ─────────────── GESTION : phase 1 -> phase 2 -> sortie ───────────────
exitPrice = float(na)
exitTxt   = ""

if inPos and not enter
    peak := math.max(peak, high)

    if not activated and peak >= entryP * (1 + actPct / 100)
        activated := true
        trailLvl  := peak * (1 - trailPct / 100)

    if activated
        trailLvl := math.max(nz(trailLvl, peak * (1 - trailPct / 100)), peak * (1 - trailPct / 100))

    if activated and low <= trailLvl
        exitPrice := trailLvl
        exitTxt   := "TRAIL"
    else if not activated and low <= stopLvl
        exitPrice := stopLvl
        exitTxt   := "STOP"
    else if not inSess
        exitPrice := close
        exitTxt   := "EOD"

if inPos and not na(exitPrice)
    pnl = (exitPrice - entryP) / entryP * 100
    label.new(bar_index, high,
              exitTxt + "\n" + str.tostring(exitPrice, format.mintick) +
              "\n" + (pnl >= 0 ? "+" : "") + str.tostring(pnl, "#.##") + "%",
              color=color.new(pnl >= 0 ? color.teal : color.red, 15), textcolor=color.white,
              style=label.style_label_down, size=size.small)
    inPos     := false
    activated := false
    entryP    := na
    peak      := na
    stopLvl   := na
    trailLvl  := na

// ─────────────────────── Affichage ───────────────────────
plot(showLines and inPos and not activated ? stopLvl  : na, "Stop -10%",  color=color.red,    linewidth=2, style=plot.style_linebr)
plot(showLines and inPos and activated     ? trailLvl : na, "Trail 2%",   color=color.orange, linewidth=2, style=plot.style_linebr)
plot(showLines and inPos                   ? entryP   : na, "Entrée",     color=color.new(color.gray, 40), linewidth=1, style=plot.style_linebr)
plot(showLines and inPos and not activated ? entryP * (1 + actPct/100) : na, "Seuil +5%",
     color=color.new(color.blue, 50), linewidth=1, style=plot.style_linebr)

// pastille du gap au début de la séance : gap + dip effectif
firstRth = inSess and not inSess[1]
if showGapLbl and firstRth and not na(gapPct)
    label.new(bar_index, high,
              "gap " + str.tostring(gapPct, "#.#") + "%" + (gapOK ? " ✓" : " ✗"),
              color=color.new(gapOK ? color.blue : color.gray, 30), textcolor=color.white,
              style=label.style_label_down, size=size.tiny)

bgcolor(inPos ? color.new(activated ? color.orange : color.green, 92) : na)
