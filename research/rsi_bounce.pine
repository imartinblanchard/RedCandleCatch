//@version=5
// =============================================================================
// RSI Bounce (gap 3-10%) — RedCandleCatch (VÉRIFICATION visuelle, 100% PRIX)
//   ENTRÉE : petit gapper (+3 à +10% vs clôture veille), 9:30->midi, RSI(14) RECROISE un seuil bas
//            (défaut 20) à la hausse, bougie VERTE. 1 entrée/jour.  SORTIE : STOP -8% / TP +20% / EOD.
//
// ⚠️ GRAPHIQUE 1 MINUTE + HEURES ÉTENDUES (ETH) ACTIVÉES (sinon gap/RSI ancrés 04:00 = faux).
// N'affiche QUE les signaux BUY/STOP/TP sur le prix. Le RSI est calculé en interne (par jour,
// reset 04:00) — il n'est PAS tracé (ajoute le RSI natif TradingView si tu veux le voir).
// =============================================================================
indicator("RSI Bounce gap3-10 — RedCandleCatch", overlay=true, max_labels_count=500)

rsiLo   = input.int(20,   "RSI seuil bas (survendu)")
gMin    = input.float(3,  "Gap min %")
gMax    = input.float(10, "Gap max %")
tpPct   = input.float(20, "Take-profit %") / 100.0
stopPct = input.float(8,  "Stop %") / 100.0
pMin    = input.float(3,  "Prix min $")
pMax    = input.float(20, "Prix max $")
sess    = input.session("0930-1200", "Fenêtre d'entrée (ET)")
useGap  = input.bool(true, "Filtre gap 3-10% (décocher pour tester)")
useSess = input.bool(true, "Filtre fenêtre horaire (décocher pour tester)")

isNewDay = ta.change(time("1D")) != 0          // 1re bougie de chaque jour (reset fiable)

// ---- RSI(14) Wilder PAR JOUR — sert au signal, NON tracé. ag/al initialisés à 0 (jamais na) ----
chg = close - close[1]
var float ag = 0.0
var float al = 0.0
if isNewDay
    ag := 0.0
    al := 0.0
else
    ag := (ag * 13.0 + math.max(chg, 0.0)) / 14.0
    al := (al * 13.0 + math.max(-chg, 0.0)) / 14.0
rs = al > 0.0 ? ag / al : (ag > 0.0 ? 1e9 : 0.0)
r  = 100.0 - 100.0 / (1.0 + rs)

// ---- gap = (plus-haut du jour depuis 04:00 - clôture veille) / clôture veille ----
pdc = request.security(syminfo.tickerid, "D", close[1])
var float hod = na
var bool  done = false
if isNewDay
    hod := high
    done := false
else
    hod := math.max(nz(hod, high), high)
gap = pdc > 0 ? (hod - pdc) / pdc * 100.0 : 0.0

// ---- conditions d'ENTRÉE ----
inSess  = not na(time(timeframe.period, sess, "America/New_York"))
crossUp = ta.crossover(r, rsiLo)
green   = close >= open
gapOk   = gap >= gMin and gap <= gMax
priceOk = close >= pMin and close <= pMax
sig     = crossUp and green and priceOk and not done and (not useGap or gapOk) and (not useSess or inSess)

// ---- position (visuel, sur le PRIX) ----
var bool  inTrade = false
var float entryP = na
var float stopL  = na
var float tpL    = na
longEntry = sig and not inTrade
if longEntry
    inTrade := true
    entryP := close
    stopL  := close * (1.0 - stopPct)
    tpL    := close * (1.0 + tpPct)
    done   := true
    label.new(bar_index, low, "BUY " + str.tostring(close, format.mintick) + " gap" + str.tostring(gap, "#") + "%", color=color.new(color.green, 0), textcolor=color.white, style=label.style_label_up, size=size.small)

nyMin = hour(time, "America/New_York") * 60 + minute(time, "America/New_York")
eod   = nyMin >= 954
reason = ""
if inTrade and not longEntry
    if low <= stopL
        reason := "STOP"
    else if high >= tpL
        reason := "TP+20%"
    else if eod
        reason := "EOD"
if inTrade and reason != ""
    xp = reason == "STOP" ? stopL : reason == "TP+20%" ? tpL : close
    pnl = (xp - entryP) / entryP * 100.0
    label.new(bar_index, high, reason + " " + str.tostring(pnl, "+#.#") + "%", color=color.new(reason == "STOP" ? color.red : color.teal, 0), textcolor=color.white, style=label.style_label_down, size=size.small)
    inTrade := false

plot(inTrade ? stopL : na, "STOP -8%", color=color.red,   style=plot.style_linebr, linewidth=1)
plot(inTrade ? tpL   : na, "TP +20%", color=color.green, style=plot.style_linebr, linewidth=1)

// DIAGNOSTIC : petit triangle gris à CHAQUE croisement RSI>seuil (même si gap/fenêtre/one-shot bloquent)
// -> si tu vois des triangles mais pas de BUY = c'est un filtre qui bloque ; si aucun triangle = RSI ne croise pas 20.
plotshape(crossUp, "croisement RSI", shape.triangleup, location.belowbar, color.new(color.gray, 20), size=size.tiny)
