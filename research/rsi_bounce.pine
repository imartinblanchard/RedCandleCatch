//@version=5
// =============================================================================
// RSI Bounce (gap 3-10%) — RedCandleCatch (VÉRIFICATION visuelle, 100% PRIX)
//   ENTRÉE : petit gapper (+3 à +10% vs clôture veille), entre 9:30 et midi, quand le RSI(14)
//            RECROISE un seuil bas (défaut 20) à la hausse, sur une bougie VERTE. 1 entrée/jour.
//   SORTIE : STOP -8% / TP +20% / sinon sortie forcée ~15:54 (EOD).
//
// ⚠️ GRAPHIQUE 1 MINUTE + HEURES ÉTENDUES (ETH) ACTIVÉES.
// NB IMPORTANT : le RSI est RECALCULÉ CHAQUE JOUR (remis à zéro à la 1re bougie du jour, 04:00),
// PAS le RSI continu de TradingView — c'est ce que fait notre backtest. Sans ça, le RSI ne descend
// jamais à 20 à l'ouverture et aucun signal n'apparaît. (Ajoute quand même le RSI natif TV si tu veux comparer.)
// =============================================================================
indicator("RSI Bounce gap3-10 — RedCandleCatch", overlay=true, max_labels_count=500)

rsiLo   = input.int(20,   "RSI seuil bas (survendu)")
gMin    = input.float(3,  "Gap min %")
gMax    = input.float(10, "Gap max %")
tpPct   = input.float(20, "Take-profit %") / 100.0
stopPct = input.float(8,  "Stop %") / 100.0
pMin    = input.float(3,  "Prix min $")
pMax    = input.float(20, "Prix max $")
sess    = input.session("0930-1200", "Fenêtre d'entrée (ET)")
useGap  = input.bool(true, "Filtre gap 3-10% (décocher pour tester)")
useSess = input.bool(true, "Filtre fenêtre horaire (décocher pour tester)")
dbg     = input.bool(true, "DEBUG : marquer TOUS les croisements RSI>seuil")

// nouveau JOUR ET (1re bougie ~04:00 avec ETH) -> reset RSI/HOD/one-shot
isNewDay = ta.change(dayofmonth(time, "America/New_York")) != 0

// ---- RSI(14) Wilder RECALCULÉ CHAQUE JOUR (comme le backtest : 1re bougie seedée à 0) ----
chg = close - close[1]
var float ag = na
var float al = na
if isNewDay
    ag := 0.0
    al := 0.0
else
    ag := (ag * 13.0 + math.max(chg, 0.0)) / 14.0
    al := (al * 13.0 + math.max(-chg, 0.0)) / 14.0
rs = al > 0.0 ? ag / al : (ag > 0.0 ? 1e9 : 0.0)
r  = 100.0 - 100.0 / (1.0 + rs)

// ---- gap = (plus-haut du jour depuis 04:00  -  clôture de la veille) / clôture veille ----
pdc = request.security(syminfo.tickerid, "D", close[1])
var float hod = na
var bool  done = false
if isNewDay
    hod := high
    done := false
else
    hod := math.max(nz(hod, high), high)
gap = pdc > 0 ? (hod - pdc) / pdc * 100.0 : 0.0

// ---- conditions d'ENTRÉE ----
inSess  = not na(time(timeframe.period, sess, "America/New_York"))
crossUp = ta.crossover(r, rsiLo)
green   = close >= open
gapOk   = gap >= gMin and gap <= gMax
priceOk = close >= pMin and close <= pMax
sig     = crossUp and green and priceOk and not done and (not useGap or gapOk) and (not useSess or inSess)

// ---- position (visuel) ----
var bool  inTrade = false
var float entryP = na
var float stopL  = na
var float tpL    = na
longEntry = sig and not inTrade
if longEntry
    inTrade := true
    entryP := close
    stopL  := close * (1.0 - stopPct)
    tpL    := close * (1.0 + tpPct)
    done   := true
    label.new(bar_index, low, "BUY " + str.tostring(close, format.mintick) + "\nRSI " + str.tostring(r, "#") + " gap " + str.tostring(gap, "#") + "%", color=color.new(color.green, 0), textcolor=color.white, style=label.style_label_up, size=size.small)

nyMin = hour(time, "America/New_York") * 60 + minute(time, "America/New_York")
eod   = nyMin >= 954
reason = ""
if inTrade and not longEntry
    if low <= stopL
        reason := "STOP"
    else if high >= tpL
        reason := "TP+20%"
    else if eod
        reason := "EOD"
if inTrade and reason != ""
    xp = reason == "STOP" ? stopL : reason == "TP+20%" ? tpL : close
    pnl = (xp - entryP) / entryP * 100.0
    label.new(bar_index, high, reason + " " + str.tostring(xp, format.mintick) + "\n" + str.tostring(pnl, "+#.#") + "%", color=color.new(reason == "STOP" ? color.red : color.teal, 0), textcolor=color.white, style=label.style_label_down, size=size.small)
    inTrade := false

plot(inTrade ? stopL : na, "STOP -8%", color=color.red,   style=plot.style_linebr, linewidth=1)
plot(inTrade ? tpL   : na, "TP +20%", color=color.green, style=plot.style_linebr, linewidth=1)

// ---- DEBUG ----
plotshape(dbg and crossUp, "croisement RSI", shape.circle, location.belowbar, color.new(color.gray, 40), size=size.tiny)
plot(gap, "gap %", color=color.new(color.aqua, 100), display=display.data_window)
plot(r,   "RSI (par jour)", color=color.new(color.orange, 100), display=display.data_window)
