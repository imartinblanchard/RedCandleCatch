//@version=5
// =============================================================================
// RSI Bounce (gap 3-10%) — RedCandleCatch (VÉRIFICATION visuelle, 100% PRIX)
//   ENTRÉE : petit gapper (+3 à +10% vs clôture veille), 9:30->midi, RSI(14) RECROISE un seuil bas
//            (défaut 20) à la hausse, bougie VERTE. 1 entrée/jour.  SORTIE : STOP -8% / TP +20% / EOD.
//
// ⚠️ GRAPHIQUE 1 MINUTE + HEURES ÉTENDUES (ETH) ACTIVÉES (sinon gap/RSI ancrés 04:00 = faux).
// Le RSI est AFFICHÉ DANS UN PANNEAU SÉPARÉ (ligne orange) et RECALCULÉ CHAQUE JOUR (reset 04:00),
// comme le backtest — PAS le RSI continu de TradingView. Les labels BUY/STOP/TP s'affichent sur le PRIX.
// Si rien ne s'affiche : regarde si la ligne RSI touche bien 20 près de l'entrée (sinon la data TV
// diffère de notre SIP) ; ou décoche « Filtre gap » pour isoler.
// =============================================================================
indicator("RSI Bounce gap3-10 — RedCandleCatch", overlay=false, max_labels_count=500)

rsiLo   = input.int(20,   "RSI seuil bas (survendu)")
gMin    = input.float(3,  "Gap min %")
gMax    = input.float(10, "Gap max %")
tpPct   = input.float(20, "Take-profit %") / 100.0
stopPct = input.float(8,  "Stop %") / 100.0
pMin    = input.float(3,  "Prix min $")
pMax    = input.float(20, "Prix max $")
sess    = input.session("0930-1200", "Fenêtre d'entrée (ET)")
useGap  = input.bool(true, "Filtre gap 3-10% (décocher pour tester)")
useSess = input.bool(true, "Filtre fenêtre horaire (décocher pour tester)")

isNewDay = ta.change(dayofmonth(time, "America/New_York")) != 0

// ---- RSI(14) Wilder RECALCULÉ CHAQUE JOUR (comme le backtest : 1re bougie seedée à 0) ----
chg = close - close[1]
var float ag = na
var float al = na
if isNewDay
    ag := 0.0
    al := 0.0
else
    ag := (ag * 13.0 + math.max(chg, 0.0)) / 14.0
    al := (al * 13.0 + math.max(-chg, 0.0)) / 14.0
rs = al > 0.0 ? ag / al : (ag > 0.0 ? 1e9 : 0.0)
r  = 100.0 - 100.0 / (1.0 + rs)

// ---- gap = (plus-haut du jour depuis 04:00 - clôture veille) / clôture veille ----
pdc = request.security(syminfo.tickerid, "D", close[1])
var float hod = na
var bool  done = false
if isNewDay
    hod := high
    done := false
else
    hod := math.max(nz(hod, high), high)
gap = pdc > 0 ? (hod - pdc) / pdc * 100.0 : 0.0

// ---- conditions d'ENTRÉE ----
inSess  = not na(time(timeframe.period, sess, "America/New_York"))
crossUp = ta.crossover(r, rsiLo)
green   = close >= open
gapOk   = gap >= gMin and gap <= gMax
priceOk = close >= pMin and close <= pMax
sig     = crossUp and green and priceOk and not done and (not useGap or gapOk) and (not useSess or inSess)

// ---- position ----
var bool  inTrade = false
var float entryP = na
var float stopL  = na
var float tpL    = na
longEntry = sig and not inTrade
if longEntry
    inTrade := true
    entryP := close
    stopL  := close * (1.0 - stopPct)
    tpL    := close * (1.0 + tpPct)
    done   := true
    label.new(bar_index, 50, "BUY " + str.tostring(close, format.mintick) + " gap" + str.tostring(gap, "#") + "%", color=color.new(color.green, 0), textcolor=color.white, style=label.style_label_up, size=size.small, force_overlay=true)

nyMin = hour(time, "America/New_York") * 60 + minute(time, "America/New_York")
eod   = nyMin >= 954
reason = ""
if inTrade and not longEntry
    if low <= stopL
        reason := "STOP"
    else if high >= tpL
        reason := "TP+20%"
    else if eod
        reason := "EOD"
if inTrade and reason != ""
    xp = reason == "STOP" ? stopL : reason == "TP+20%" ? tpL : close
    pnl = (xp - entryP) / entryP * 100.0
    label.new(bar_index, 50, reason + " " + str.tostring(pnl, "+#.#") + "%", color=color.new(reason == "STOP" ? color.red : color.teal, 0), textcolor=color.white, style=label.style_label_down, size=size.small, force_overlay=true)
    inTrade := false

// prix : lignes STOP/TP sur le graphique (force_overlay)
plot(inTrade ? stopL : na, "STOP -8%", color=color.red,   style=plot.style_linebr, linewidth=1, force_overlay=true)
plot(inTrade ? tpL   : na, "TP +20%", color=color.green, style=plot.style_linebr, linewidth=1, force_overlay=true)

// ---- PANNEAU RSI (par jour) ----
plot(r, "RSI par-jour", color=color.orange, linewidth=2)
hline(rsiLo, "seuil bas", color=color.red, linestyle=hline.style_dashed)
hline(50, "", color=color.new(color.gray, 70))
hline(80, "", color=color.new(color.gray, 85))
plotshape(crossUp, "croisement RSI>seuil", shape.triangleup, location.bottom, color.new(color.aqua, 0), size=size.tiny)
plot(gap, "gap %", color=color.new(color.aqua, 100), display=display.data_window)
