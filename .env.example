# Alpaca API credentials (SIP data plan)
# Copy this file to .env and fill in your keys from https://app.alpaca.markets
# Paper and live keys both work for MARKET DATA; the scanner only reads data.
ALPACA_API_KEY_ID=your_key_id_here
ALPACA_API_SECRET_KEY=your_secret_here

# Data feed: 'sip' (full market, paid) or 'iex' (free, thin pre-market)
ALPACA_DATA_FEED=sip
